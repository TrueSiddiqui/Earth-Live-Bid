generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/topg_earth_collective/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  fullName      String
  role          String    @default("member") // member | admin
  tier          String?   // Millionaire | Billionaire | Titan
  status        String    @default("pending") // pending | approved | rejected
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  emailVerified DateTime?
  image         String?

  application       Application?
  syndicatesCreated Syndicate[]       @relation("SyndicateCreator")
  syndicateMembers  SyndicateMember[]
  bids              Bid[]
  accounts          Account[]
  sessions          Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Application {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Step 1: Personal Identity
  legalName        String
  nationality      String
  dateOfBirth      String
  passportPath     String?  // cloud_storage_path
  passportPublic   Boolean  @default(false)
  countryResidence String

  // Step 2: Wealth Declaration
  netWorthRange    String   // $1M-$10M | $10M-$100M | $100M-$1B | $1B+
  tier             String   // Millionaire | Billionaire | Titan
  sourceOfWealth   String
  primaryAssetClass String

  // Step 3: Banking
  bankName         String
  bankCountry      String
  swiftCode        String
  bankDocPath      String?  // cloud_storage_path
  bankDocPublic    Boolean  @default(false)

  declaredNetWorthUsd Float?
  valuationDate      String?
  valuationNotes     String?
  attestedAt         DateTime?
  identityChecked    Boolean @default(false)
  wealthChecked      Boolean @default(false)
  authenticityChecked Boolean @default(false)
  reviewedBy         String?
  verifiedUntil      DateTime?

  // Status
  status           String   @default("pending") // pending | approved | rejected
  adminNote        String?
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Syndicate {
  id              String            @id @default(cuid())
  name            String
  description     String
  targetCategory  String
  minContribution Float
  maxMembers      Int
  poolTotal       Float             @default(0)
  isLocked        Boolean           @default(false)
  creatorId       String
  creator         User              @relation("SyndicateCreator", fields: [creatorId], references: [id])
  members         SyndicateMember[]
  bids            Bid[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model SyndicateMember {
  id           String    @id @default(cuid())
  syndicateId  String
  syndicate    Syndicate @relation(fields: [syndicateId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  pledgeAmount Float
  joinedAt     DateTime  @default(now())

  @@unique([syndicateId, userId])
}

model Auction {
  id           String   @id @default(cuid())
  assetName    String
  category     String   // Oceans | Minerals | Atmosphere | Orbital Space | Forests | Freshwater
  description  String
  imageUrl     String?
  reservePrice Float
  currentBid   Float    @default(0)
  bidCount     Int      @default(0)
  endsAt       DateTime
  status       String   @default("active") // active | closed
  tierRequired String?  // null = all tiers, or Billionaire | Titan
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  bids         Bid[]
}

model Bid {
  id          String    @id @default(cuid())
  auctionId   String
  auction     Auction   @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  syndicateId String?
  syndicate   Syndicate? @relation(fields: [syndicateId], references: [id])
  amount      Float
  createdAt   DateTime  @default(now())
}

model VerificationUpload {
  id                 String @id @default(cuid())
  userId             String
  cloud_storage_path String @unique
  isPublic           Boolean @default(false)
  contentType        String
  size               Int
  createdAt          DateTime @default(now())
}

model AdminAction {
  id           String   @id @default(cuid())
  action       String   // approve | reject
  targetType   String   // application | auction | syndicate
  targetId     String
  note         String?
  performedAt  DateTime @default(now())
  actorId      String?
}
